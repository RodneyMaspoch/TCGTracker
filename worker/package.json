{
  "name": "tcgtracker-worker",
  "version": "1.0.0",
  "private": true,
  "description": "TCGTracker backend on Cloudflare Workers + D1 — free-tier deploy target. Frontend files are shared with the Node/Express version in ../public; this only replaces the server.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tcgtracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tcgtracker-db --remote",
    "gen-migration": "node scripts/gen-migration.mjs > migrations/0001_init.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "hono": "^4.6.0"
  }
}
